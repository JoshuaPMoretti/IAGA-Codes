# programa para gerar seis números aleatórios para a Mega-Sena
from random import randint

jogo = []

i = 1
while (i <= 6):
    n = randint(1, 60)
    if (n not in jogo):
        jogo.append(n)
        i = i + 1

# Comando para ordenar os números em ordem crescente
jogo.sort()

# Apresenta o jogo
print(jogo)
