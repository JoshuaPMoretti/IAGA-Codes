a = [10, 2, 7, 8, 5, 3, 22, 17, 18]

item = int(input())

print("{", end="")

for i in range(len(a)):
    print(f"{i}:{a[i]}", end="")
    if i < len(a) - 1:
        print(", ", end="")

print("}")
print()

encontrou = False

for i in range(len(a)):
    if a[i] == item:
        print(f"Item: {item}, foi encontrado na posicao {i}.")
        encontrou = True
        break

if encontrou == False:
    print(f'Item: {item}, "nao" foi encontrado.')