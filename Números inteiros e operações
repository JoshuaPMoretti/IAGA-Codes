# Leitura dos dois números inteiros
a = int(input())
b = int(input())

# Cálculos
soma = a + b
subtracao = a - b
multiplicacao = a * b
divisao_inteira = a // b
divisao_real = a / b

# Exibição dos resultados no formato exato
print(f"{a} + {b} = {soma}")
print(f"{a} - {b} = {subtracao}")
print(f"{a} X {b} = {multiplicacao}")
print(f"{a} / {b} = {divisao_inteira}")
print(f"{a} / {b} = {divisao_real:.2f}")